{
  "name": "@dsh-foundry/daily-agent",
  "version": "0.1.0",
  "description": "Agent-scoped daily behavior over the official Standard preset",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@dsh-foundry/daily-contract": "workspace:*",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.6"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.6 <0.2.0"
  },
  "scripts": {
    "bundle": "node --experimental-strip-types build.ts"
  },
  "dshFoundry": {
    "distribution": "dsh-foundry",
    "qualified": true
  }
}
